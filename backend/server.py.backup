class ChatRequest(BaseModel):
    message: str
    session_id: Optional[str] = None


def current_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat()


def get_gemini_key() -> str:
    configured = AGENT_CONFIG.get("gemini_api_key", "")
    if configured:
        return configured
    for name in ("GEMINI_API_KEY", "ZENTRO_GEMINI_API_KEY"):
        value = os.getenv(name, "").strip()
        if value:
            return value
    return ""


def build_agent_statuses() -> List[Dict[str, Any]]:
    if AgentCoordinator is None:
        return [
            {
                "name": "Mandate Creator",
                "description": "Fallback operational status",
                "status": "online",
                "currentActivity": "Demo mode monitoring",
                "confidence": 97,
                "decision": "APPROVE",
                "riskScore": 12,
            },
            {
                "name": "Policy Judge",
                "description": "Compliance review",
                "status": "idle",
                "currentActivity": "Demo mode monitoring",
                "confidence": 88,
                "decision": "CHECKING",
                "riskScore": 24,
            },
            {
                "name": "Risk Detection",
                "description": "Threat screening",
                "status": "processing",
                "currentActivity": "Demo mode monitoring",
                "confidence": 91,
                "decision": "REVIEW",
                "riskScore": 18,
            },
        ]

    coordinator = AgentCoordinator()
    source_tx = SEED_TRANSACTIONS[0]
    results = coordinator.run_all(source_tx)["results"]
    status_map = {
        "APPROVE": "online",
        "REVIEW": "idle",
        "CHECKING": "processing",
        "ESCALATE": "error",
    }

    output: List[Dict[str, Any]] = []
    for result in results:
        output.append(
            {
                "name": result["agent"],
                "description": result["matched_policy"],
                "status": status_map.get(result["decision"], "idle"),
                "currentActivity": "Monitored latest transaction flow",
                "confidence": int(result["confidence"] * 100),
                "decision": result["decision"],
                "riskScore": result["risk_score"],
            }
        )
    return output


