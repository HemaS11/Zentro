@app.get("/api/health")
def health() -> Dict[str, Any]:
    return {"status": "ok", "service": "Zentro API"}


@app.get("/api/dashboard")
def dashboard() -> Dict[str, Any]:
    return build_dashboard_payload()


@app.get("/api/agents")
def agents() -> Dict[str, Any]:
    return {"agents": build_agent_statuses()}


@app.get("/api/transactions")
def transactions() -> Dict[str, Any]:
    return {"transactions": SEED_TRANSACTIONS, "count": len(SEED_TRANSACTIONS), "dataSource": "demo"}


@app.get("/api/mandates")
def mandates() -> Dict[str, Any]:
    return {"mandates": SEED_MANDATES, "count": len(SEED_MANDATES)}


@app.get("/api/analytics")
def analytics() -> Dict[str, Any]:
    return build_analytics_payload()


@app.get("/api/settings")
def settings() -> Dict[str, Any]:
    return {"settings": SEED_SETTINGS}


@app.post("/chat/message")
def chat_message(payload: ChatRequest) -> Dict[str, Any]:
    message = (payload.message or "").strip()
    if not message:
        raise HTTPException(status_code=400, detail="Message is required.")

    gemini_key = get_gemini_key()
    if gemini_key:
        try:
            if genai is not None:
                genai.configure(api_key=gemini_key)
                model = genai.GenerativeModel("gemini-2.0-flash")
                response = model.generate_content(
                    "You are Zentro AI support. Use the backend context to answer: " + message
                )
                answer = response.text.strip() if hasattr(response, "text") else str(response)
                return {
                    "answer": answer,
                    "dataUnavailable": False,
                    "lastUpdated": current_timestamp(),
                    "source": "gemini-live",
                }
            if google_genai is not None:
                client = google_genai.Client(api_key=gemini_key)
                model = client.models.generate_content(
                    model="gemini-2.0-flash",
                    contents="You are Zentro AI support. Use the backend context to answer: " + message,
                )
                answer = getattr(model, "text", str(model))
                return {
                    "answer": answer,
                    "dataUnavailable": False,
                    "lastUpdated": current_timestamp(),
                    "source": "gemini-live",
                }
        except Exception:
            pass

    risk_summary = (
        "Your current approval risk is moderate. One transaction is blocked and another is escalated, "
        "while the rest remain within policy. The largest risk area is an unrecognized vendor and a "
        "high-value travel request that should be reviewed against the active mandate rules."
    )

    return {
        "answer": (
            "Live Gemini connectivity is currently unavailable because the backend is missing a valid GEMINI_API_KEY. "
            "I can still provide the latest cached financial context from the secure backend data service. "
            f"Context: {risk_summary}"
        ),
        "dataUnavailable": True,
        "lastUpdated": current_timestamp(),
        "source": "backend-cache",
    }


if __name__ == "__main__":
    import uvicorn

    uvicorn.run("backend.server:app", host="0.0.0.0", port=8000, reload=False)
